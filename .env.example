APP_ENV=local
DEBUG_MODE=false
APP_SECRET=replace_with_64_char_hex_secret
TOKEN_KID=v1
COMPANY_TZ=Asia/Kolkata

# Database Configuration
DEFAULT_DB_HOST=127.0.0.1
DEFAULT_DB_DATABASE=corp_quizz
DEFAULT_DB_USER=quizz_user
DEFAULT_DB_PASSWORD=quizz_password

# Redis Configuration
REDIS_SOCKET=/var/run/redis/redis.sock
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Domain & SSL Automation
# In production, set APP_DOMAIN to your subdomain (e.g. quiz.yourdomain.com).
# deploy.sh will automatically configure Nginx virtualhost and request/maintain Let's Encrypt SSL.
APP_DOMAIN=
SSL_EMAIL=

# Quiz Tuning
GRACE_MS=3000
OVERTIME_BUFFER_S=600
BASE_URL=http://localhost:8000

# Data Reset (admin feature)
# Required to enable the /admin/data-reset menu; must be at least 8 characters.
# Leave blank to disable the feature entirely (fail-closed).
PASS_CODE=
