[Unit]
Description=CorpQuiz Redis-to-MySQL Flusher Daemon
After=network.target redis-server.service mysql.service
Requires=redis-server.service mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/corpquiz
ExecStart=/usr/bin/php bin/console quiz:flusher
Restart=always
RestartSec=2s
StandardOutput=append:/var/log/corpquiz/flusher.log
StandardError=append:/var/log/corpquiz/flusher_error.log

[Install]
WantedBy=multi-user.target
