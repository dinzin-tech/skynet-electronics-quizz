# ==============================================================================
# CorpQuiz Production MySQL 8.0 Tuning (2 vCPU, 8 GB RAM VPS)
# ==============================================================================
[mysqld]
bind-address = 127.0.0.1
default_authentication_plugin = mysql_native_password

# Character set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Connection sizing
max_connections = 100
wait_timeout = 60
interactive_timeout = 60

# InnoDB Memory & Buffer Pool (~38% of 8 GB RAM)
innodb_buffer_pool_size = 3G
innodb_buffer_pool_instances = 3
innodb_log_file_size = 512M
innodb_log_buffer_size = 32M

# Durability policy (Strict ACID compliant for production audits)
# NOTE: Can be set to 2 temporarily for massive write-heavy bulk events if approved
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT

# Table & File settings
table_open_cache = 2000
open_files_limit = 65535

# Slow Query Logging for monitoring
slow_query_log = 1
slow_query_log_file = /var/log/mysql/mysql-slow.log
long_query_time = 0.5
log_queries_not_using_indexes = 0
