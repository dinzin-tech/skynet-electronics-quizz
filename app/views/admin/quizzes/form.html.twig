{% extends "admin/layout.html.twig" %}

{% block page_title %}{% if is_edit %}Edit Quiz{% else %}Create New Quiz{% endif %}{% endblock %}

{% block content %}
<div style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
    <a href="/admin/quizzes" style="font-size: 0.875rem; color: #2563eb; text-decoration: none;">&larr; Back to Quizzes</a>
    {% if is_edit %}
        <a href="/admin/quizzes/{{ quiz_id }}/questions" class="btn btn-primary" style="padding: 8px 18px; font-size: 0.875rem; text-decoration: none;">
            ✏️ Manage & Edit Questions
        </a>
    {% endif %}
</div>

{% if error %}
    <div class="alert alert-error">{{ error }}</div>
{% endif %}

<div class="card" style="max-width: 800px;">
    {% if is_edit %}
        <div style="margin-bottom: 20px; padding: 14px 18px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <div>
                <strong style="color: #166534; font-size: 0.925rem;">Shareable Employee Quiz Link:</strong>
                <div style="font-size: 0.85rem; color: #15803d; margin-top: 2px;">
                    <code>http://localhost:8000/quiz/{{ old.code|default('') }}</code>
                </div>
            </div>
            <button type="button" class="btn btn-primary" style="padding: 7px 16px; font-size: 0.85rem; font-weight: 600; background: #16a34a; border-color: #16a34a;" onclick="copyQuizLink('{{ old.code|default('') }}', this)">
                🔗 Copy Shareable Link
            </button>
        </div>

        <div style="margin-bottom: 24px; padding: 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <strong style="color: #1e40af; font-size: 0.975rem;">Quiz Questions & Options</strong>
                <p style="font-size: 0.825rem; color: #3b82f6; margin: 2px 0 0 0;">Add new questions, edit prompts, change correct options, or delete questions.</p>
            </div>
            <a href="/admin/quizzes/{{ quiz_id }}/questions" class="btn btn-primary" style="padding: 7px 16px; font-size: 0.85rem; text-decoration: none; font-weight: 600;">
                ✏️ Edit Questions
            </a>
        </div>
    {% endif %}

    <form action="{% if is_edit %}/admin/quizzes/{{ quiz_id }}/edit{% else %}/admin/quizzes/create{% endif %}" method="POST">
        <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
            Basic Details
        </h3>

        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
            <div class="form-group">
                <label class="form-label" for="title">Quiz Title *</label>
                <input type="text" id="title" name="title" required class="form-control" placeholder="e.g. Q4 Compliance & Ethics Assessment" value="{{ old.title|default('') }}">
            </div>
            <div class="form-group">
                <label class="form-label" for="code">Unique Code *</label>
                <input type="text" id="code" name="code" required class="form-control" placeholder="e.g. COMP-2026" value="{{ old.code|default('') }}">
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="description">Instructions / Description</label>
            <textarea id="description" name="description" rows="3" class="form-control" placeholder="Instructions shown on employee entry screen...">{{ old.description|default('') }}</textarea>
        </div>

        <h3 style="font-size: 1.1rem; font-weight: 600; margin: 24px 0 16px 0; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
            Window & Timing (Asia/Kolkata Display, Stored in UTC)
        </h3>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
            <div class="form-group">
                <label class="form-label" for="window_start">Window Start *</label>
                <input type="datetime-local" id="window_start" name="window_start" required class="form-control" value="{{ old.window_start|default('') }}">
            </div>
            <div class="form-group">
                <label class="form-label" for="window_end">Window End *</label>
                <input type="datetime-local" id="window_end" name="window_end" required class="form-control" value="{{ old.window_end|default('') }}">
            </div>
            <div class="form-group">
                <label class="form-label" for="duration_minutes">Duration (Minutes) *</label>
                <input type="number" id="duration_minutes" name="duration_minutes" required min="1" value="{{ old.duration_minutes|default(30) }}" class="form-control">
            </div>
        </div>

        <h3 style="font-size: 1.1rem; font-weight: 600; margin: 24px 0 16px 0; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
            Scoring Configuration (Admin Configurable)
        </h3>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16px;">
            <div class="form-group">
                <label class="form-label" for="marks_per_correct">Marks / Correct</label>
                <input type="number" step="0.5" id="marks_per_correct" name="marks_per_correct" value="{{ old.marks_per_correct|default('1.0') }}" class="form-control">
            </div>
            <div class="form-group">
                <label class="form-label" for="negative_marks">Negative Marks</label>
                <input type="number" step="0.25" id="negative_marks" name="negative_marks" value="{{ old.negative_marks|default('0.0') }}" class="form-control">
            </div>
            <div class="form-group">
                <label class="form-label" for="unanswered_penalty">Unanswered Penalty</label>
                <input type="number" step="0.25" id="unanswered_penalty" name="unanswered_penalty" value="{{ old.unanswered_penalty|default('0.0') }}" class="form-control">
            </div>
            <div class="form-group">
                <label class="form-label" for="pass_mark">Pass Mark</label>
                <input type="number" step="0.5" id="pass_mark" name="pass_mark" value="{{ old.pass_mark|default('20.0') }}" class="form-control">
            </div>
        </div>

        <h3 style="font-size: 1.1rem; font-weight: 600; margin: 24px 0 16px 0; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
            Navigation & Randomization
        </h3>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
            <div>
                <label style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; margin-bottom: 8px;">
                    <input type="checkbox" name="allow_back" value="1" {% if old is null or old.allow_back is defined %}checked{% endif %}> Allow Back Navigation
                </label>
                <label style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; margin-bottom: 8px;">
                    <input type="checkbox" name="allow_skip" value="1" {% if old is null or old.allow_skip is defined %}checked{% endif %}> Allow Skip Questions
                </label>
                <label style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem;">
                    <input type="checkbox" name="allow_review_screen" value="1" {% if old is null or old.allow_review_screen is defined %}checked{% endif %}> Allow Review Screen
                </label>
            </div>
            <div>
                <label style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; margin-bottom: 8px;">
                    <input type="checkbox" name="randomize_questions" value="1" {% if old is null or old.randomize_questions is defined %}checked{% endif %}> Randomize Question Order (Fisher-Yates)
                </label>
                <label style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem;">
                    <input type="checkbox" name="randomize_options" value="1" {% if old is null or old.randomize_options is defined %}checked{% endif %}> Randomize Option Order (Fisher-Yates)
                </label>
            </div>
        </div>

        <h3 style="font-size: 1.1rem; font-weight: 600; margin: 24px 0 16px 0; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
            Target Audience (Eligible Employees)
        </h3>

        <div style="margin-bottom: 24px;">
            <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 14px;">
                Choose which employees are authorized and will have attempts generated for this assessment upon publishing.
            </p>
            <div style="display: flex; gap: 24px; margin-bottom: 16px;">
                <label style="display: flex; align-items: center; gap: 8px; font-size: 0.95rem; cursor: pointer;">
                    <input type="radio" name="target_audience" value="all" id="audience_all" {% if old is null or old.target_audience|default('all') == 'all' %}checked{% endif %} onchange="toggleAudienceGroups(false)">
                    <strong>All Active Employees</strong>
                </label>
                <label style="display: flex; align-items: center; gap: 8px; font-size: 0.95rem; cursor: pointer;">
                    <input type="radio" name="target_audience" value="groups" id="audience_groups" {% if old is not null and old.target_audience|default('') == 'groups' %}checked{% endif %} onchange="toggleAudienceGroups(true)">
                    <strong>Specific Groups / Departments</strong>
                </label>
            </div>

            <div id="groups-selector" style="display: {% if old is not null and old.target_audience|default('') == 'groups' %}block{% else %}none{% endif %}; background: #f8fafc; border: 1px solid var(--border-color); border-radius: 8px; padding: 18px; margin-top: 12px;">
                <div style="font-weight: 600; font-size: 0.9rem; margin-bottom: 10px; color: #1e293b;">Select Employee Groups / Departments:</div>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px;">
                    {% for group in groups %}
                        <label style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem; cursor: pointer; padding: 6px 10px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px;">
                            <input type="checkbox" name="target_groups[]" value="{{ group.id }}" {% if old is not null and group.id in old.target_groups|default([]) %}checked{% endif %}>
                            <div>
                                <span style="font-weight: 500;">{{ group.name }}</span>
                                {% if group.description %}
                                <div style="font-size: 0.75rem; color: #64748b;">{{ group.description }}</div>
                                {% endif %}
                            </div>
                        </label>
                    {% endfor %}
                </div>
                <div style="font-size: 0.8rem; color: #64748b; margin-top: 12px;">
                    When published, only active employees belonging to the selected groups will be enrolled.
                </div>
            </div>
        </div>

        <script>
            function toggleAudienceGroups(show) {
                var el = document.getElementById('groups-selector');
                if (el) {
                    el.style.display = show ? 'block' : 'none';
                }
            }

            function copyQuizLink(code, btnElement) {
                const origin = window.location.origin;
                const url = `${origin}/quiz/${code}`;
                
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(url);
                } else {
                    const textArea = document.createElement("textarea");
                    textArea.value = url;
                    document.body.appendChild(textArea);
                    textArea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textArea);
                }

                const originalText = btnElement.innerHTML;
                btnElement.innerHTML = "✓ Copied Link!";
                
                setTimeout(() => {
                    btnElement.innerHTML = originalText;
                }, 2000);
            }
        </script>

        <button type="submit" class="btn btn-primary" style="padding: 10px 24px; font-size: 0.95rem;">
            {% if is_edit %}Save Changes{% else %}Save Quiz as Draft{% endif %}
        </button>
    </form>
</div>
{% endblock %}
