    </div>
</div>

<!-- Share Quiz Modal -->
<div id="share-quiz-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; width: 90%; max-width: 540px; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); overflow: hidden;">
        <div style="padding: 16px 20px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 1.1rem; font-weight: 600; margin: 0; color: #1e293b;">🔗 Share Quiz</h3>
            <button type="button" onclick="closeShareModal()" style="background: none; border: none; font-size: 1.25rem; cursor: pointer; color: #64748b;">&times;</button>
        </div>
        <div style="padding: 20px; display: flex; flex-direction: column; gap: 16px;">
            <div>
                <label style="display: block; font-size: 0.875rem; font-weight: 600; color: #334155; margin-bottom: 4px;" id="share-quiz-title-label">Quiz Link</label>
                <p style="font-size: 0.825rem; color: #64748b; margin: 0 0 12px 0;">Employees can use this link to access and take the assessment during the active window.</p>
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="share-link-input" readonly class="form-control" style="font-size: 0.875rem; background: #f8fafc; font-family: monospace; font-weight: 500;" onclick="this.select()">
                    <button type="button" id="copy-share-btn" class="btn btn-primary" style="white-space: nowrap; padding: 8px 16px; font-weight: 600;" onclick="copyShareLink()">
                        Copy Link
                    </button>
                </div>
                <div id="copy-feedback" style="display: none; font-size: 0.8rem; color: #16a34a; font-weight: 600; margin-top: 6px;">✓ Link copied to clipboard!</div>
            </div>

            <div style="border-top: 1px solid #f1f5f9; padding-top: 14px; display: flex; gap: 10px; align-items: center; justify-content: space-between; flex-wrap: wrap;">
                <span style="font-size: 0.825rem; color: #64748b; font-weight: 500;">Quick Actions:</span>
                <div style="display: flex; gap: 8px;">
                    <a id="share-email-btn" href="#" target="_blank" class="btn btn-secondary" style="font-size: 0.8rem; padding: 5px 12px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                        📧 Email
                    </a>
                    <a id="share-wa-btn" href="#" target="_blank" class="btn btn-secondary" style="font-size: 0.8rem; padding: 5px 12px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; color: #15803d; border-color: #bbf7d0; background: #f0fdf4;">
                        💬 WhatsApp
                    </a>
                    <a id="open-quiz-btn" href="#" target="_blank" class="btn btn-secondary" style="font-size: 0.8rem; padding: 5px 12px; text-decoration: none;">
                        ↗ Open Link
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function openShareModal(code, title) {
    const modal = document.getElementById('share-quiz-modal');
    const input = document.getElementById('share-link-input');
    const titleLabel = document.getElementById('share-quiz-title-label');
    const copyFeedback = document.getElementById('copy-feedback');
    const copyBtn = document.getElementById('copy-share-btn');
    const emailBtn = document.getElementById('share-email-btn');
    const waBtn = document.getElementById('share-wa-btn');
    const openBtn = document.getElementById('open-quiz-btn');

    const shareUrl = window.location.origin + '/quiz/' + code;
    input.value = shareUrl;
    if (titleLabel) titleLabel.textContent = title ? `Share "${title}"` : 'Quiz Link';

    if (copyFeedback) copyFeedback.style.display = 'none';
    if (copyBtn) copyBtn.textContent = 'Copy Link';

    if (openBtn) openBtn.href = shareUrl;

    const emailSubject = encodeURIComponent(`Assessment Link: ${title || 'Quiz'}`);
    const emailBody = encodeURIComponent(`Hi,\n\nPlease click the link below to access your quiz assessment:\n\n${shareUrl}\n\nQuiz Code: ${code}`);
    if (emailBtn) emailBtn.href = `mailto:?subject=${emailSubject}&body=${emailBody}`;

    const waText = encodeURIComponent(`Assessment Link: ${title || 'Quiz'}\n${shareUrl}\nCode: ${code}`);
    if (waBtn) waBtn.href = `https://api.whatsapp.com/send?text=${waText}`;

    modal.style.display = 'flex';
}

function closeShareModal() {
    document.getElementById('share-quiz-modal').style.display = 'none';
}

function copyShareLink() {
    const input = document.getElementById('share-link-input');
    const copyFeedback = document.getElementById('copy-feedback');
    const copyBtn = document.getElementById('copy-share-btn');

    input.select();
    input.setSelectionRange(0, 99999);

    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(input.value).then(onCopySuccess).catch(fallbackCopy);
    } else {
        fallbackCopy();
    }

    function fallbackCopy() {
        try {
            document.execCommand('copy');
            onCopySuccess();
        } catch (err) {
            console.error('Failed to copy', err);
        }
    }

    function onCopySuccess() {
        if (copyFeedback) copyFeedback.style.display = 'block';
        if (copyBtn) copyBtn.textContent = 'Copied!';
        setTimeout(() => {
            if (copyBtn) copyBtn.textContent = 'Copy Link';
        }, 3000);
    }
}
</script>
