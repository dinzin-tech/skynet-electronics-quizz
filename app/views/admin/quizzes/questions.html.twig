{% extends "admin/layout.html.twig" %}

{% block page_title %}Manage Questions - {{ quiz.title }}{% endblock %}

{% block content %}
<div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
    <a href="/admin/quizzes" style="font-size: 0.875rem; color: #2563eb; text-decoration: none;">&larr; Back to Quizzes</a>
    <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
        <button type="button" class="btn btn-secondary" style="padding: 6px 14px; font-size: 0.85rem; background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe;" onclick="openShareModal('{{ quiz.code }}', '{{ quiz.title|e('js') }}')">🔗 Share Quiz Link</button>
        {% if quiz.status == 'draft' %}
            <form action="/admin/quizzes/{{ quiz.id }}/publish" method="POST" style="display: inline;" onsubmit="return confirm('Ready to publish this quiz? This will freeze questions, create the immutable snapshot, and materialize the employee roster.');">
                <button type="submit" class="btn btn-primary" style="padding: 6px 14px; font-size: 0.85rem;">Publish Quiz Now</button>
            </form>
        {% endif %}
    </div>
</div>

{% if success %}
    <div class="alert alert-success">{{ success }}</div>
{% endif %}
{% if error %}
    <div class="alert alert-error">{{ error }}</div>
{% endif %}

<!-- Quiz Overview Card -->
<div class="card" style="margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0;">{{ quiz.title }}</h2>
                <code>{{ quiz.code }}</code>
                {% if quiz.status == 'published' %}
                    <span class="badge badge-success">Published (v{{ quiz.current_version }})</span>
                {% elseif quiz.status == 'draft' %}
                    <span class="badge badge-warning">Draft</span>
                {% else %}
                    <span class="badge badge-info">{{ quiz.status }}</span>
                {% endif %}
            </div>
            <p style="font-size: 0.875rem; color: #64748b; margin: 0 0 6px 0;">
                Duration: {{ (quiz.duration_seconds / 60)|round }} mins &bull; 
                Window: {{ quiz.start_at|company_date('d M Y, h:i A') }} to {{ quiz.end_at|company_date('d M Y, h:i A') }} ({{ company_tz }})
            </p>
            <div style="display: flex; gap: 16px; margin-top: 8px; flex-wrap: wrap;">
                <span class="badge" style="background: #eff6ff; color: #1d4ed8; font-size: 0.8rem; padding: 4px 10px;">
                    Section A: {{ quiz.random_question_count|default(bank_questions|length) }} MCQs (Sampled)
                </span>
                <span class="badge" style="background: #fdf4ff; color: #86198f; font-size: 0.8rem; padding: 4px 10px;">
                    Section B: {{ written_questions|length }} Fixed Written Questions
                </span>
                <span class="badge" style="background: #f0fdf4; color: #15803d; font-size: 0.8rem; padding: 4px 10px;">
                    Section C: 1 Common Feedback Question
                </span>
            </div>
        </div>
        <div>
            <a href="/admin/quizzes/{{ quiz.id }}/edit" class="btn btn-secondary" style="font-size: 0.825rem; padding: 5px 12px;">
                Edit Quiz Settings
            </a>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- SECTION A: MCQs (Connected to Question Bank) -->
<!-- ========================================== -->
<div class="card" style="margin-bottom: 24px; border-left: 4px solid #2563eb;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; flex-wrap: wrap; gap: 12px;">
        <div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="badge" style="background: #2563eb; color: #fff; font-size: 0.775rem; font-weight: 700;">SECTION A</span>
                <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: #1e293b;">
                    Multiple Choice Questions (MCQ Pool)
                </h3>
            </div>
            <p style="font-size: 0.85rem; color: #64748b; margin: 6px 0 0 0;">
                Connected to a reusable Question Bank of approximately 30–40 MCQs. A configurable number of MCQs is randomly allocated to each participant.
            </p>
        </div>
        <div style="display: flex; gap: 8px; align-items: center;">
            {% if bank %}
                <a href="/admin/question-banks/{{ bank.id }}/questions" class="btn btn-primary" style="font-size: 0.85rem; padding: 6px 14px;">
                    Manage Question Bank &rarr;
                </a>
            {% else %}
                <a href="/admin/quizzes/{{ quiz.id }}/edit" class="btn btn-warning" style="font-size: 0.85rem; padding: 6px 14px;">
                    Link a Question Bank
                </a>
            {% endif %}
        </div>
    </div>

    {% if bank %}
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <div>
                    <h4 style="font-size: 1rem; font-weight: 600; margin: 0; color: #0f172a;">
                        📚 {{ bank.title }}
                    </h4>
                    {% if bank.description %}
                        <p style="font-size: 0.825rem; color: #64748b; margin: 4px 0 0 0;">{{ bank.description }}</p>
                    {% endif %}
                </div>
                <div style="display: flex; gap: 12px; align-items: center;">
                    <div style="text-align: right;">
                        <span style="font-size: 0.75rem; color: #64748b; text-transform: uppercase; font-weight: 600;">Bank Pool</span>
                        <div style="font-size: 1.1rem; font-weight: 700; color: #1e293b;">{{ bank_questions|length }} MCQs</div>
                    </div>
                    <div style="text-align: right;">
                        <span style="font-size: 0.75rem; color: #64748b; text-transform: uppercase; font-weight: 600;">Random Draw</span>
                        <div style="font-size: 1.1rem; font-weight: 700; color: #2563eb;">
                            {{ quiz.random_question_count|default(bank_questions|length) }} per participant
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.825rem; color: #64748b;">
            <span>
                ✓ Random MCQ sampling happens independently for each participant.
                Auto-grading applies only to Section A MCQs.
            </span>
            <a href="/admin/question-banks/{{ bank.id }}/questions" style="color: #2563eb; text-decoration: none; font-weight: 500;">
                Add / Edit MCQs or Bulk Import Excel/CSV &rarr;
            </a>
        </div>
    {% else %}
        <div class="alert alert-warning" style="margin: 0;">
            No Question Bank is currently linked to this quiz. Please <a href="/admin/quizzes/{{ quiz.id }}/edit">edit the quiz</a> to link a Question Bank for Section A.
        </div>
    {% endif %}
</div>

<!-- ========================================== -->
<!-- SECTION B: Written Survey (Fixed Questions) -->
<!-- ========================================== -->
<div class="card" style="margin-bottom: 24px; border-left: 4px solid #9333ea;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
        <div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="badge" style="background: #9333ea; color: #fff; font-size: 0.775rem; font-weight: 700;">SECTION B</span>
                <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: #1e293b;">
                    Fixed Written Survey Questions (HR Survey)
                </h3>
            </div>
            <p style="font-size: 0.85rem; color: #64748b; margin: 6px 0 0 0;">
                Questions entered manually by HR directly for this quiz. <strong>Every eligible participant receives these fixed questions</strong>. Written answers are downloaded separately in reports and graded manually by HR without penalizing candidate accuracy.
            </p>
        </div>
        {% if quiz.status == 'draft' %}
            <button type="button" class="btn btn-secondary" style="font-size: 0.85rem; padding: 6px 14px; background: #faf5ff; color: #7e22ce; border-color: #e9d5ff;" onclick="toggleAddWrittenForm()">
                + Add Written Question
            </button>
        {% endif %}
    </div>

    <!-- Add Written Question Form (Draft only) -->
    {% if quiz.status == 'draft' %}
    <div id="add-written-form-box" style="display: none; background: #faf5ff; border: 1px solid #e9d5ff; border-radius: 8px; padding: 18px; margin-bottom: 20px;">
        <h4 style="font-size: 0.95rem; font-weight: 600; margin: 0 0 12px 0; color: #581c87;">
            Add New Fixed Written Survey Question
        </h4>
        <form action="/admin/quizzes/{{ quiz.id }}/questions/written/add" method="POST" enctype="multipart/form-data">
            <div class="form-group" style="margin-bottom: 14px;">
                <label class="form-label" style="font-weight: 500; color: #374151;">Question Prompt *</label>
                <textarea name="question_text" rows="3" required class="form-control" placeholder="Enter the survey / written question prompt (e.g., 'Detail your store visit schedule and key observations this month')..."></textarea>
            </div>
            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label" style="font-weight: 500; color: #374151;">Optional Supporting Image (JPG, PNG, WEBP, GIF)</label>
                <input type="file" name="question_image" accept="image/*" class="form-control" style="max-width: 420px; font-size: 0.85rem;">
            </div>
            <div style="display: flex; gap: 10px;">
                <button type="submit" class="btn btn-primary" style="background: #9333ea; border-color: #7e22ce; padding: 8px 18px; font-size: 0.85rem;">
                    Save Written Question
                </button>
                <button type="button" class="btn btn-secondary" style="font-size: 0.85rem; padding: 8px 14px;" onclick="toggleAddWrittenForm()">
                    Cancel
                </button>
            </div>
        </form>
    </div>
    {% endif %}

    <!-- Written Questions List -->
    {% if written_questions|length > 0 %}
        <div style="display: flex; flex-direction: column; gap: 12px;">
            {% for wq in written_questions %}
            <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;">
                <div style="flex: 1;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                        <span style="font-weight: 700; color: #9333ea; font-size: 0.9rem;">Section B - Q{{ loop.index }}</span>
                        <span class="badge" style="background: #f3e8ff; color: #7e22ce; font-size: 0.725rem;">Fixed Written</span>
                    </div>
                    <div style="font-size: 0.925rem; font-weight: 600; color: #1e293b; line-height: 1.45;">
                        {{ wq.question_text }}
                    </div>
                    {% if wq.image_path %}
                        <div style="margin-top: 10px;">
                            <a href="{{ wq.image_path }}" target="_blank">
                                <img src="{{ wq.image_path }}" alt="Supporting image" style="max-height: 100px; max-width: 260px; border-radius: 4px; border: 1px solid #cbd5e1; object-fit: contain;">
                            </a>
                        </div>
                    {% endif %}
                </div>
                {% if quiz.status == 'draft' %}
                <div style="display: flex; gap: 6px; align-items: center;">
                    <button type="button" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.775rem;" onclick="openEditWrittenModal({{ wq.id }}, {{ wq.question_text|json_encode }}, {{ wq.image_path|json_encode }})">
                        Edit
                    </button>
                    <form action="/admin/quizzes/{{ quiz.id }}/questions/written/{{ wq.id }}/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this written question?');">
                        <button type="submit" class="btn" style="background: #fee2e2; color: #dc2626; border: none; padding: 4px 10px; font-size: 0.775rem; border-radius: 4px; cursor: pointer;">
                            Delete
                        </button>
                    </form>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    {% else %}
        <div style="padding: 24px 16px; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px; text-align: center; color: #64748b; font-size: 0.875rem;">
            No fixed written questions added yet for this quiz.
            {% if quiz.status == 'draft' %}
                <br><button type="button" class="btn btn-secondary" style="margin-top: 8px; font-size: 0.8rem; padding: 4px 12px;" onclick="toggleAddWrittenForm()">+ Add Written Question</button>
            {% endif %}
        </div>
    {% endif %}
</div>

<!-- ========================================== -->
<!-- SECTION C: Common Feedback Question        -->
<!-- ========================================== -->
<div class="card" style="margin-bottom: 24px; border-left: 4px solid #16a34a;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; flex-wrap: wrap; gap: 12px;">
        <div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="badge" style="background: #16a34a; color: #fff; font-size: 0.775rem; font-weight: 700;">SECTION C</span>
                <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: #1e293b;">
                    Common Feedback Block
                </h3>
            </div>
            <p style="font-size: 0.85rem; color: #64748b; margin: 6px 0 0 0;">
                Retained for every eligible participant automatically. Responses are captured at submission and included in CSV exports.
            </p>
        </div>
        <a href="/admin/quizzes/{{ quiz.id }}/edit" class="btn btn-secondary" style="font-size: 0.8rem; padding: 4px 12px;">
            Edit Feedback Prompt
        </a>
    </div>

    <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 14px 18px;">
        <div style="font-size: 0.8rem; color: #15803d; font-weight: 700; text-transform: uppercase; margin-bottom: 4px;">
            Current Feedback Prompt:
        </div>
        <div style="font-size: 0.925rem; color: #14532d; font-style: italic;">
            "{{ quiz.feedback_question|default('We value your thoughts! Please share any feedback or suggestions regarding this assessment:') }}"
        </div>
    </div>
</div>

<!-- Edit Written Question Modal -->
<div id="edit-written-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; width: 90%; max-width: 560px; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); overflow: hidden;">
        <div style="padding: 16px 20px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 1.1rem; font-weight: 600; margin: 0; color: #1e293b;">Edit Section B Written Question</h3>
            <button type="button" onclick="closeEditWrittenModal()" style="background: none; border: none; font-size: 1.25rem; cursor: pointer; color: #64748b;">&times;</button>
        </div>
        <form id="edit-written-form" action="" method="POST" enctype="multipart/form-data" style="padding: 20px;">
            <div class="form-group" style="margin-bottom: 14px;">
                <label class="form-label" style="font-weight: 500;">Question Prompt *</label>
                <textarea id="edit-written-text" name="question_text" rows="3" required class="form-control"></textarea>
            </div>
            <div id="edit-written-current-img-box" style="margin-bottom: 14px; display: none;">
                <label class="form-label" style="font-weight: 500;">Current Image:</label>
                <div style="display: flex; align-items: center; gap: 12px;">
                    <img id="edit-written-current-img" src="" alt="Current image" style="max-height: 80px; border-radius: 4px; border: 1px solid #cbd5e1;">
                    <label style="font-size: 0.825rem; color: #dc2626; cursor: pointer; display: flex; align-items: center; gap: 4px;">
                        <input type="checkbox" id="edit-written-remove-img" name="remove_image" value="1"> Remove current image
                    </label>
                </div>
            </div>
            <div class="form-group" style="margin-bottom: 18px;">
                <label class="form-label" style="font-weight: 500;">Replace / Upload Image (Optional)</label>
                <input type="file" name="question_image" accept="image/*" class="form-control" style="font-size: 0.85rem;">
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #e2e8f0; padding-top: 14px;">
                <button type="button" class="btn btn-secondary" onclick="closeEditWrittenModal()">Cancel</button>
                <button type="submit" class="btn btn-primary" style="background: #9333ea; border-color: #7e22ce;">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- Share Quiz Modal -->
<div id="share-quiz-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; width: 90%; max-width: 540px; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); overflow: hidden;">
        <div style="padding: 16px 20px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 1.1rem; font-weight: 600; margin: 0; color: #1e293b;">🔗 Share Quiz</h3>
            <button type="button" onclick="closeShareModal()" style="background: none; border: none; font-size: 1.25rem; cursor: pointer; color: #64748b;">&times;</button>
        </div>
        <div style="padding: 20px; display: flex; flex-direction: column; gap: 16px;">
            <div>
                <label style="display: block; font-size: 0.875rem; font-weight: 600; color: #334155; margin-bottom: 4px;" id="share-quiz-title-label">Quiz Link</label>
                <p style="font-size: 0.825rem; color: #64748b; margin: 0 0 12px 0;">Employees can use this link to access and take the assessment during the active window.</p>
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="share-link-input" readonly class="form-control" style="font-size: 0.875rem; background: #f8fafc; font-family: monospace; font-weight: 500;" onclick="this.select()">
                    <button type="button" id="copy-share-btn" class="btn btn-primary" style="white-space: nowrap; padding: 8px 16px; font-weight: 600;" onclick="copyShareLink()">
                        Copy Link
                    </button>
                </div>
                <div id="copy-feedback" style="display: none; font-size: 0.8rem; color: #16a34a; font-weight: 600; margin-top: 6px;">✓ Link copied to clipboard!</div>
            </div>
            <div style="border-top: 1px solid #f1f5f9; padding-top: 14px; display: flex; gap: 10px; align-items: center; justify-content: space-between; flex-wrap: wrap;">
                <span style="font-size: 0.825rem; color: #64748b; font-weight: 500;">Quick Actions:</span>
                <div style="display: flex; gap: 8px;">
                    <a id="share-email-btn" href="#" target="_blank" class="btn btn-secondary" style="font-size: 0.8rem; padding: 5px 12px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                        📧 Email
                    </a>
                    <a id="share-wa-btn" href="#" target="_blank" class="btn btn-secondary" style="font-size: 0.8rem; padding: 5px 12px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; color: #15803d; border-color: #bbf7d0; background: #f0fdf4;">
                        💬 WhatsApp
                    </a>
                    <a id="open-quiz-btn" href="#" target="_blank" class="btn btn-secondary" style="font-size: 0.8rem; padding: 5px 12px; text-decoration: none;">
                        ↗ Open Link
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function toggleAddWrittenForm() {
    var box = document.getElementById('add-written-form-box');
    if (!box) return;
    box.style.display = box.style.display === 'none' ? 'block' : 'none';
}

function openEditWrittenModal(qid, text, imagePath) {
    var modal = document.getElementById('edit-written-modal');
    var form = document.getElementById('edit-written-form');
    var textEl = document.getElementById('edit-written-text');
    var imgBox = document.getElementById('edit-written-current-img-box');
    var imgEl = document.getElementById('edit-written-current-img');
    var removeBox = document.getElementById('edit-written-remove-img');

    form.action = '/admin/quizzes/{{ quiz.id }}/questions/written/' + qid + '/edit';
    textEl.value = text;

    if (imagePath) {
        imgEl.src = imagePath;
        imgBox.style.display = 'block';
        if (removeBox) removeBox.checked = false;
    } else {
        imgBox.style.display = 'none';
    }

    modal.style.display = 'flex';
}

function closeEditWrittenModal() {
    document.getElementById('edit-written-modal').style.display = 'none';
}

function openShareModal(code, title) {
    const modal = document.getElementById('share-quiz-modal');
    const input = document.getElementById('share-link-input');
    const titleLabel = document.getElementById('share-quiz-title-label');
    const copyFeedback = document.getElementById('copy-feedback');
    const copyBtn = document.getElementById('copy-share-btn');
    const emailBtn = document.getElementById('share-email-btn');
    const waBtn = document.getElementById('share-wa-btn');
    const openBtn = document.getElementById('open-quiz-btn');

    const shareUrl = window.location.origin + '/quiz/' + code;
    input.value = shareUrl;
    if (titleLabel) titleLabel.textContent = title ? `Share "${title}"` : 'Quiz Link';

    if (copyFeedback) copyFeedback.style.display = 'none';
    if (copyBtn) copyBtn.textContent = 'Copy Link';

    if (openBtn) openBtn.href = shareUrl;

    const emailSubject = encodeURIComponent(`Assessment Link: ${title || 'Quiz'}`);
    const emailBody = encodeURIComponent(`Hi,\n\nPlease click the link below to access your quiz assessment:\n\n${shareUrl}\n\nQuiz Code: ${code}`);
    if (emailBtn) emailBtn.href = `mailto:?subject=${emailSubject}&body=${emailBody}`;

    const waText = encodeURIComponent(`Assessment Link: ${title || 'Quiz'}\n${shareUrl}\nCode: ${code}`);
    if (waBtn) waBtn.href = `https://api.whatsapp.com/send?text=${waText}`;

    modal.style.display = 'flex';
}

function closeShareModal() {
    document.getElementById('share-quiz-modal').style.display = 'none';
}

function copyShareLink() {
    const input = document.getElementById('share-link-input');
    const copyFeedback = document.getElementById('copy-feedback');
    const copyBtn = document.getElementById('copy-share-btn');

    input.select();
    input.setSelectionRange(0, 99999);

    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(input.value).then(onCopySuccess).catch(fallbackCopy);
    } else {
        fallbackCopy();
    }

    function fallbackCopy() {
        try {
            document.execCommand('copy');
            onCopySuccess();
        } catch (err) {
            console.error('Failed to copy', err);
        }
    }

    function onCopySuccess() {
        if (copyFeedback) copyFeedback.style.display = 'block';
        if (copyBtn) copyBtn.textContent = 'Copied!';
        setTimeout(() => {
            if (copyBtn) copyBtn.textContent = 'Copy Link';
        }, 3000);
    }
}
</script>
{% endblock %}
