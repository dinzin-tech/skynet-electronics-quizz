{% extends "admin/layout.html.twig" %}

{% block page_title %}Real-time Dashboard{% endblock %}

{% block content %}
<div style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
    <div>
        <h2 style="font-size: 1.15rem; font-weight: 600; color: #1e293b;">System Overview (9 Core KPIs)</h2>
        <p style="font-size: 0.85rem; color: #64748b;">Live metrics from Redis during assessment windows & MySQL cache</p>
    </div>
    <div>
        <button class="btn btn-secondary" onclick="window.location.reload()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            Refresh
        </button>
    </div>
</div>

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-title">Total Active Employees</div>
        <div class="kpi-val">{{ global_kpis.total_employees|number_format }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-title">Total Quizzes</div>
        <div class="kpi-val">{{ global_kpis.total_quizzes }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-title">Published Quizzes</div>
        <div class="kpi-val" style="color: #2563eb;">{{ global_kpis.published_quizzes }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-title">Completed Attempts</div>
        <div class="kpi-val" style="color: #16a34a;">{{ global_kpis.completed_attempts|number_format }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-title">In-Progress Attempts</div>
        <div class="kpi-val" style="color: #d97706;">{{ global_kpis.in_progress_attempts|number_format }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-title">Absent Employees</div>
        <div class="kpi-val" style="color: #dc2626;">{{ global_kpis.absent_employees|number_format }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-title">Average Score</div>
        <div class="kpi-val">{{ global_kpis.avg_score }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-title">Average Accuracy</div>
        <div class="kpi-val">{{ global_kpis.avg_accuracy }}%</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-title">Avg Completion Time</div>
        <div class="kpi-val">{{ global_kpis.avg_completion_time_s }}s</div>
    </div>
</div>

<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 style="font-size: 1.05rem; font-weight: 600;">Active Quiz Real-time Telemetry</h3>
        {% if quizzes|length > 0 %}
        <div>
            <select class="form-control" style="width: auto; display: inline-block;" onchange="window.location.href='/admin/dashboard?quiz_id=' + this.value">
                {% for q in quizzes %}
                    <option value="{{ q.id }}" {% if selected_quiz_id == q.id %}selected{% endif %}>
                        [{{ q.code }}] {{ q.title }} ({{ q.status|upper }})
                    </option>
                {% endfor %}
            </select>
        </div>
        {% endif %}
    </div>

    {% if quiz_kpis %}
    <div style="background: #f1f5f9; border-radius: 8px; padding: 16px; margin-bottom: 20px; display: flex; gap: 24px; align-items: center;">
        <div>
            <span style="font-size: 0.8rem; color: #64748b; font-weight: 600; text-transform: uppercase;">Telemetry Source:</span>
            <strong style="color: #2563eb; text-transform: uppercase;">{{ quiz_kpis.source }}</strong>
        </div>
        <div>
            <span style="font-size: 0.8rem; color: #64748b; font-weight: 600; text-transform: uppercase;">Total Eligible:</span>
            <strong>{{ quiz_kpis.total_eligible }}</strong>
        </div>
        <div>
            <span style="font-size: 0.8rem; color: #64748b; font-weight: 600; text-transform: uppercase;">Pass Rate:</span>
            <strong>{{ quiz_kpis.pass_rate }}%</strong>
        </div>
    </div>

    <div class="kpi-grid" style="margin-bottom: 0;">
        <div class="kpi-card">
            <div class="kpi-title">Not Started</div>
            <div class="kpi-val">{{ quiz_kpis.not_started }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">In Progress</div>
            <div class="kpi-val" style="color: #d97706;">{{ quiz_kpis.in_progress }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Completed</div>
            <div class="kpi-val" style="color: #16a34a;">{{ quiz_kpis.completed }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Absent</div>
            <div class="kpi-val" style="color: #dc2626;">{{ quiz_kpis.absent }}</div>
        </div>
    </div>
    {% else %}
    <p style="color: #64748b; font-size: 0.9rem;">No active quiz selected or available.</p>
    {% endif %}
</div>

{% if selected_quiz_id > 0 and question_summary is not empty %}
<div class="card" style="padding: 0; margin-top: 24px;">
    <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
            <h3 style="font-size: 1.05rem; font-weight: 600; margin: 0; display: flex; align-items: center; gap: 8px;">
                <span>📊 Question-Wise Performance Breakdown</span>
                <span class="badge badge-info" style="font-size: 0.75rem;">{{ question_summary|length }} Questions</span>
            </h3>
            <p style="font-size: 0.825rem; color: #64748b; margin: 4px 0 0 0;">
                Showing employee response counts and ratios across completed attempts.
            </p>
        </div>
        <div>
            <form action="/admin/reports/export" method="POST" style="margin: 0; display: inline-block;">
                <input type="hidden" name="report_type" value="question_summary">
                <input type="hidden" name="quiz_id" value="{{ selected_quiz_id }}">
                <button type="submit" class="btn btn-secondary" style="font-size: 0.8rem; padding: 6px 14px; display: flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Download Question CSV
                </button>
            </form>
        </div>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Question</th>
                    <th style="width: 100px;">Answered</th>
                    <th style="width: 140px;">Correct</th>
                    <th style="width: 140px;">Incorrect</th>
                    <th style="width: 140px;">Unanswered</th>
                    <th style="width: 180px;">Accuracy Bar</th>
                </tr>
            </thead>
            <tbody>
                {% for q in question_summary %}
                <tr>
                    <td><strong>Q{{ q.display_order }}</strong></td>
                    <td>
                        <div style="font-weight: 500; color: #1e293b; max-width: 480px; white-space: normal; line-height: 1.4;">
                            {{ q.question_text }}
                        </div>
                    </td>
                    <td>
                        <strong style="color: #334155;">{{ q.answered_count }}</strong>
                        <span style="font-size: 0.775rem; color: #94a3b8;">/ {{ q.total_attempts }}</span>
                    </td>
                    <td>
                        <span style="display: inline-flex; align-items: center; gap: 4px; color: #16a34a; font-weight: 700;">
                            ✓ {{ q.correct_count }}
                        </span>
                        <div style="font-size: 0.75rem; color: #16a34a;">{{ q.correct_pct }}%</div>
                    </td>
                    <td>
                        <span style="display: inline-flex; align-items: center; gap: 4px; color: #dc2626; font-weight: 700;">
                            ✗ {{ q.incorrect_count }}
                        </span>
                        <div style="font-size: 0.75rem; color: #dc2626;">{{ q.incorrect_pct }}%</div>
                    </td>
                    <td>
                        <span style="display: inline-flex; align-items: center; gap: 4px; color: #64748b; font-weight: 600;">
                            — {{ q.unanswered_count }}
                        </span>
                        <div style="font-size: 0.75rem; color: #64748b;">{{ q.unanswered_pct }}%</div>
                    </td>
                    <td>
                        <div style="background: #e2e8f0; border-radius: 999px; height: 10px; width: 100%; overflow: hidden; display: flex;">
                            <div style="background: #16a34a; width: {{ q.correct_pct }}%; height: 100%;" title="Correct: {{ q.correct_pct }}%"></div>
                            <div style="background: #dc2626; width: {{ q.incorrect_pct }}%; height: 100%;" title="Incorrect: {{ q.incorrect_pct }}%"></div>
                            <div style="background: #94a3b8; width: {{ q.unanswered_pct }}%; height: 100%;" title="Unanswered: {{ q.unanswered_pct }}%"></div>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}
