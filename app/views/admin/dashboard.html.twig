{% extends "admin/layout.html.twig" %}

{% block page_title %}Assessment Dashboard & Analytics{% endblock %}

{% block content %}
<div style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div>
        <h2 style="font-size: 1.25rem; font-weight: 700; color: #1e293b;">Assessment Dashboard & Telemetry</h2>
        <p style="font-size: 0.85rem; color: #64748b;">Live performance metrics, Zone breakdown, Question-level analysis, and Score benchmarks.</p>
    </div>
    <div style="display: flex; gap: 10px; align-items: center;">
        {% if selected_quiz_id > 0 %}
            <form action="/admin/reports/export" method="POST" style="margin: 0;">
                <input type="hidden" name="report_type" value="comprehensive">
                <input type="hidden" name="format" value="xlsx">
                <input type="hidden" name="quiz_id" value="{{ selected_quiz_id }}">
                <input type="hidden" name="zone" value="{{ selected_zone }}">
                <input type="hidden" name="designation" value="{{ selected_designation }}">
                <input type="hidden" name="exclude_test" value="{% if exclude_test %}1{% else %}0{% endif %}">
                <button type="submit" class="btn btn-primary" style="font-size: 0.85rem; padding: 7px 16px; display: flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Download Week 2 XLSX
                </button>
            </form>
        {% endif %}
        <button class="btn btn-secondary" onclick="window.location.reload()" style="font-size: 0.85rem; padding: 7px 14px; display: flex; align-items: center; gap: 6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            Refresh
        </button>
    </div>
</div>

<!-- Assessment Filter Bar -->
<div class="card" style="margin-bottom: 24px; padding: 16px 20px; background: #ffffff;">
    <form method="GET" action="/admin/dashboard" id="dashFilterForm" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) auto; gap: 14px; align-items: flex-end;">
        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="filter_quiz_id"><strong>Quiz / Week</strong></label>
            <select id="filter_quiz_id" name="quiz_id" class="form-control" onchange="document.getElementById('dashFilterForm').submit()">
                {% for q in quizzes %}
                    <option value="{{ q.id }}" {% if selected_quiz_id == q.id %}selected{% endif %}>
                        [{{ q.code }}] {{ q.title }} ({{ q.status|upper }})
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="filter_zone">Zone / Region</label>
            <select id="filter_zone" name="zone" class="form-control" onchange="document.getElementById('dashFilterForm').submit()">
                <option value="">-- All Zones --</option>
                {% for z in zones|default([]) %}
                    <option value="{{ z }}" {% if selected_zone == z %}selected{% endif %}>{{ z }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="filter_designation">Designation</label>
            <select id="filter_designation" name="designation" class="form-control" onchange="document.getElementById('dashFilterForm').submit()">
                <option value="">-- All Designations --</option>
                {% for d in designations|default([]) %}
                    <option value="{{ d }}" {% if selected_designation == d %}selected{% endif %}>{{ d }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group" style="margin-bottom: 0; display: flex; align-items: center; height: 38px;">
            <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; cursor: pointer; color: #475569;">
                <input type="checkbox" name="exclude_test" value="1" {% if exclude_test %}checked{% endif %} onchange="document.getElementById('dashFilterForm').submit()">
                <span>Exclude Test Accounts</span>
            </label>
        </div>

        <div>
            <a href="/admin/dashboard?quiz_id={{ selected_quiz_id }}" class="btn btn-secondary" style="font-size: 0.8rem; padding: 8px 12px;">Reset Filters</a>
        </div>
    </form>
</div>

{% if overall_summary %}
<!-- Section 1: Overall Summary (Week 2 Layout) -->
<div style="margin-bottom: 24px;">
    <h3 style="font-size: 1.05rem; font-weight: 700; color: #1e293b; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        <span>📈 Overall Summary</span>
        <span style="font-size: 0.75rem; color: #64748b; font-weight: 400;">(Reconciled participation and score averages)</span>
    </h3>
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-title">Active Eligible OECs</div>
            <div class="kpi-val">{{ overall_summary.eligible_employees|number_format }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Started Quiz</div>
            <div class="kpi-val" style="color: #2563eb;">{{ overall_summary.started_quiz|number_format }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Completed Attempts</div>
            <div class="kpi-val" style="color: #16a34a;">{{ overall_summary.completed_attempts|number_format }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">In Progress</div>
            <div class="kpi-val" style="color: #d97706;">{{ overall_summary.in_progress_attempts|number_format }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Absent Employees</div>
            <div class="kpi-val" style="color: #dc2626;">{{ overall_summary.absent_employees|number_format }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Participation Rate</div>
            <div class="kpi-val" style="color: #0284c7;">{{ overall_summary.participation_pct }}%</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Average Quiz Score</div>
            <div class="kpi-val">{{ overall_summary.avg_score }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Average Accuracy</div>
            <div class="kpi-val">{{ overall_summary.avg_accuracy }}%</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Avg Completion Time</div>
            <div class="kpi-val">{{ overall_summary.avg_completion_time_s }}s</div>
        </div>
    </div>
</div>
{% endif %}

<!-- Section 2: Zone Summary Table (Week 2 Layout) -->
{% if zone_summary and zone_summary.zones is not empty %}
<div class="card" style="padding: 0; margin-bottom: 24px;">
    <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h3 style="font-size: 1.05rem; font-weight: 700; margin: 0; color: #1e293b;">🗺️ Zone Performance Summary</h3>
            <p style="font-size: 0.8rem; color: #64748b; margin: 4px 0 0 0;">Breakdown across company zones with participation rate and average score.</p>
        </div>
        <span class="badge badge-info" style="font-size: 0.75rem;">{{ zone_summary.zones|length }} Zones</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Zone / Region</th>
                    <th style="text-align: right;">Eligible OECs</th>
                    <th style="text-align: right;">Not Started</th>
                    <th style="text-align: right;">In Progress</th>
                    <th style="text-align: right;">Completed</th>
                    <th style="text-align: right;">Absent</th>
                    <th style="text-align: right;">Participation %</th>
                    <th style="text-align: right;">Average Score</th>
                </tr>
            </thead>
            <tbody>
                {% for z in zone_summary.zones %}
                <tr>
                    <td><strong>{{ z.zone }}</strong></td>
                    <td style="text-align: right;">{{ z.eligible|number_format }}</td>
                    <td style="text-align: right; color: #64748b;">{{ z.not_started|number_format }}</td>
                    <td style="text-align: right; color: #d97706;">{{ z.in_progress|number_format }}</td>
                    <td style="text-align: right; color: #16a34a; font-weight: 600;">{{ z.completed|number_format }}</td>
                    <td style="text-align: right; color: #dc2626;">{{ z.absent|number_format }}</td>
                    <td style="text-align: right;">
                        <span style="font-weight: 700; color: #0284c7;">{{ z.participation_pct }}%</span>
                    </td>
                    <td style="text-align: right;"><strong>{{ z.avg_score }}</strong></td>
                </tr>
                {% endfor %}
            </tbody>
            {% if zone_summary.total %}
            <tfoot>
                <tr style="background: #f8fafc; font-weight: 700; border-top: 2px solid var(--border-color);">
                    <td><strong>Total (Consolidated)</strong></td>
                    <td style="text-align: right;">{{ zone_summary.total.eligible|number_format }}</td>
                    <td style="text-align: right;">{{ zone_summary.total.not_started|number_format }}</td>
                    <td style="text-align: right;">{{ zone_summary.total.in_progress|number_format }}</td>
                    <td style="text-align: right; color: #16a34a;">{{ zone_summary.total.completed|number_format }}</td>
                    <td style="text-align: right; color: #dc2626;">{{ zone_summary.total.absent|number_format }}</td>
                    <td style="text-align: right; color: #0284c7;">{{ zone_summary.total.participation_pct }}%</td>
                    <td style="text-align: right;">{{ zone_summary.total.avg_score }}</td>
                </tr>
            </tfoot>
            {% endif %}
        </table>
    </div>
</div>
{% endif %}

<!-- Section 3: Score Summary & HR 50-Point Benchmark -->
{% if score_summary %}
<div class="card" style="margin-bottom: 24px; padding: 20px;">
    <h3 style="font-size: 1.05rem; font-weight: 700; margin: 0 0 16px 0; color: #1e293b;">
        🎯 Score Summary & Weighted Benchmarks
    </h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 20px;">
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px;">
            <div style="font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: 600;">Max Possible Score</div>
            <div style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin-top: 4px;">{{ score_summary.max_possible_score }}</div>
            <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 2px;">Configured in quiz settings</div>
        </div>
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px;">
            <div style="font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: 600;">Raw Average Score</div>
            <div style="font-size: 1.5rem; font-weight: 700; color: #2563eb; margin-top: 4px;">{{ score_summary.avg_score_raw }}</div>
            <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 2px;">Across completed attempts</div>
        </div>
        <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 14px;">
            <div style="font-size: 0.75rem; text-transform: uppercase; color: #1e40af; font-weight: 700;">Weighted Score (Out of 50)</div>
            <div style="font-size: 1.5rem; font-weight: 800; color: #1d4ed8; margin-top: 4px;">{{ score_summary.weighted_score_50 }} / 50</div>
            <div style="font-size: 0.75rem; color: #3b82f6; margin-top: 2px;">HR Formula: (Raw / Max) * 50</div>
        </div>
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px;">
            <div style="font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: 600;">Zero-Scored Attempts</div>
            <div style="font-size: 1.5rem; font-weight: 700; color: #dc2626; margin-top: 4px;">{{ score_summary.zero_scored_attempts }}</div>
            <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 2px;">Submitted with 0 marks</div>
        </div>
    </div>

    <!-- Score Distribution Brackets -->
    {% if score_summary.brackets %}
    <h4 style="font-size: 0.875rem; font-weight: 600; color: #475569; margin-bottom: 10px;">Score Distribution Brackets:</h4>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px;">
        <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px; padding: 10px; text-align: center;">
            <div style="font-size: 0.75rem; color: #991b1b; font-weight: 600;">&lt; 20 Marks</div>
            <div style="font-size: 1.15rem; font-weight: 700; color: #dc2626; margin-top: 2px;">{{ score_summary.brackets.lt_20|number_format }}</div>
        </div>
        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 6px; padding: 10px; text-align: center;">
            <div style="font-size: 0.75rem; color: #92400e; font-weight: 600;">20 - 29 Marks</div>
            <div style="font-size: 1.15rem; font-weight: 700; color: #d97706; margin-top: 2px;">{{ score_summary.brackets.b_20_29|number_format }}</div>
        </div>
        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px; padding: 10px; text-align: center;">
            <div style="font-size: 0.75rem; color: #166534; font-weight: 600;">30 - 39 Marks</div>
            <div style="font-size: 1.15rem; font-weight: 700; color: #16a34a; margin-top: 2px;">{{ score_summary.brackets.b_30_39|number_format }}</div>
        </div>
        <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 6px; padding: 10px; text-align: center;">
            <div style="font-size: 0.75rem; color: #065f46; font-weight: 600;">40 - 50 Marks</div>
            <div style="font-size: 1.15rem; font-weight: 700; color: #059669; margin-top: 2px;">{{ score_summary.brackets.b_40_50|number_format }}</div>
        </div>
    </div>
    {% endif %}
</div>
{% endif %}

<!-- Section 4: Question-Wise Analysis Table (Week 2 Layout) -->
{% if selected_quiz_id > 0 and question_summary is not empty %}
<div class="card" style="padding: 0; margin-top: 24px;">
    <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
            <h3 style="font-size: 1.05rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 8px; color: #1e293b;">
                <span>📊 Question Performance Analysis</span>
                <span class="badge badge-info" style="font-size: 0.75rem;">{{ question_summary|length }} Questions in Bank</span>
            </h3>
            <p style="font-size: 0.8rem; color: #64748b; margin: 4px 0 0 0;">
                Separates <strong>Assigned</strong> from <strong>Not Assigned</strong> based on participant layouts. MCQ Accuracy = <code>Correct / Answered</code>.
            </p>
        </div>
        <div>
            <form action="/admin/reports/export" method="POST" style="margin: 0; display: inline-block;">
                <input type="hidden" name="report_type" value="question_summary">
                <input type="hidden" name="format" value="xlsx">
                <input type="hidden" name="quiz_id" value="{{ selected_quiz_id }}">
                <input type="hidden" name="zone" value="{{ selected_zone }}">
                <input type="hidden" name="designation" value="{{ selected_designation }}">
                <input type="hidden" name="exclude_test" value="{% if exclude_test %}1{% else %}0{% endif %}">
                <button type="submit" class="btn btn-secondary" style="font-size: 0.8rem; padding: 6px 14px; display: flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Download Question XLSX
                </button>
            </form>
        </div>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th style="width: 45px;">#</th>
                    <th>Question & Correct Answer</th>
                    <th style="width: 80px; text-align: center;">Type</th>
                    <th style="width: 85px; text-align: right;">Assigned</th>
                    <th style="width: 85px; text-align: right;">Answered</th>
                    <th style="width: 80px; text-align: right;">Correct</th>
                    <th style="width: 80px; text-align: right;">Wrong</th>
                    <th style="width: 95px; text-align: right;">Unanswered</th>
                    <th style="width: 95px; text-align: right;">Not Assigned</th>
                    <th style="width: 140px; text-align: right;">MCQ Accuracy</th>
                </tr>
            </thead>
            <tbody>
                {% for q in question_summary %}
                <tr>
                    <td><strong>{{ loop.index }}</strong></td>
                    <td>
                        <div style="font-weight: 600; color: #1e293b; max-width: 440px; white-space: normal; line-height: 1.4;">
                            {{ q.question_text }}
                        </div>
                        {% if q.correct_answer_text %}
                            <div style="font-size: 0.775rem; color: #16a34a; margin-top: 4px; display: flex; align-items: center; gap: 4px;">
                                <span style="font-weight: 700;">Key:</span> {{ q.correct_answer_text }}
                            </div>
                        {% endif %}
                    </td>
                    <td style="text-align: center;">
                        <span style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; background: #f1f5f9; padding: 2px 6px; border-radius: 4px; color: #475569;">
                            {{ q.question_type }}
                        </span>
                    </td>
                    <td style="text-align: right;">
                        <strong>{{ q.assigned_count }}</strong>
                    </td>
                    <td style="text-align: right;">
                        {{ q.answered_count }}
                    </td>
                    <td style="text-align: right; color: #16a34a; font-weight: 600;">
                        {{ q.correct_count }}
                    </td>
                    <td style="text-align: right; color: #dc2626; font-weight: 600;">
                        {{ q.incorrect_count }}
                    </td>
                    <td style="text-align: right; color: #64748b;">
                        {{ q.assigned_unanswered }}
                    </td>
                    <td style="text-align: right; color: #94a3b8;">
                        {{ q.not_assigned }}
                    </td>
                    <td style="text-align: right;">
                        {% if q.question_type == 'written' %}
                            <span style="color: #64748b; font-size: 0.75rem;">Manual HR</span>
                        {% else %}
                            <span style="font-weight: 700; color: {% if q.accuracy_pct >= 70 %}#16a34a{% elseif q.accuracy_pct >= 40 %}#d97706{% else %}#dc2626{% endif %};">
                                {{ q.accuracy_pct }}%
                            </span>
                            <div style="font-size: 0.7rem; color: #94a3b8;">{{ q.correct_count }}/{{ q.answered_count }}</div>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}
