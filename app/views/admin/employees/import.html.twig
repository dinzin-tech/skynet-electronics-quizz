{% extends "admin/layout.html.twig" %}

{% block page_title %}Bulk Employee CSV Upload{% endblock %}

{% block content %}
<div style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
    <a href="/admin/employees" style="font-size: 0.875rem; color: #2563eb; text-decoration: none;">&larr; Back to Employees</a>
    <a href="/admin/employees/sample-csv" class="btn btn-secondary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        Download Sample CSV
    </a>
</div>

{% if error %}
    <div class="alert alert-error">{{ error }}</div>
{% endif %}

{% if success %}
    <div class="alert alert-success">{{ success }}</div>
{% endif %}

{% if result_summary %}
<div class="card" style="border-left: 4px solid #16a34a;">
    <h3 style="font-size: 1.15rem; font-weight: 600; margin-bottom: 12px; color: #166534;">Import Completed</h3>
    <p style="margin-bottom: 16px; font-size: 0.95rem;">
        Total Processed: <strong>{{ result_summary.total }}</strong> |
        Successfully Imported: <strong style="color: #16a34a;">{{ result_summary.imported }}</strong> |
        Failed / Skipped: <strong style="color: #dc2626;">{{ result_summary.failed }}</strong>
    </p>
    {% if result_summary.report_url %}
    <div style="margin-top: 12px;">
        <a href="{{ result_summary.report_url }}" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download Failed Rows Report (CSV)
        </a>
    </div>
    {% endif %}
</div>
{% endif %}

{% if preview %}
<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
        <div>
            <h3 style="font-size: 1.05rem; font-weight: 600;">CSV Validation Preview (First 10 Rows)</h3>
            <p style="font-size: 0.85rem; color: #64748b;">
                Found <strong>{{ preview.total_rows }}</strong> total rows:
                <span style="color: #16a34a; font-weight: 600;">{{ preview.valid_count }} Valid</span>,
                <span style="color: #dc2626; font-weight: 600;">{{ preview.duplicate_count }} Duplicates / Errors</span>
            </p>
        </div>
        <form action="/admin/employees/import/execute" method="POST">
            <input type="hidden" name="file_path" value="{{ file_path }}">
            <button type="submit" class="btn btn-primary" {% if preview.valid_count == 0 %}disabled{% endif %}>
                Confirm & Import {{ preview.valid_count }} Valid Employees
            </button>
        </form>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th style="width: 60px;">Row</th>
                    <th>ZONE/Region</th>
                    <th>EMP CODE</th>
                    <th>EMP NAME</th>
                    <th>DEPARTMENT</th>
                    <th>DESIGNATION</th>
                    <th>Validation</th>
                </tr>
            </thead>
            <tbody>
                {% for row in preview.preview %}
                <tr>
                    <td>{{ row.row }}</td>
                    <td>
                        {% if row.zone_region %}
                            <span style="font-weight: 500;">{{ row.zone_region }}</span>
                        {% else %}
                            <span style="color: #94a3b8;">—</span>
                        {% endif %}
                    </td>
                    <td><strong>{{ row.code }}</strong></td>
                    <td style="font-weight: 500;">{{ row.name }}</td>
                    <td>
                        {% if row.department %}
                            <span style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 0.8rem;">{{ row.department }}</span>
                        {% else %}
                            <span style="color: #94a3b8;">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if row.designation %}
                            <span style="font-size: 0.85rem; color: #475569;">{{ row.designation }}</span>
                        {% else %}
                            <span style="color: #94a3b8;">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if row.is_valid %}
                            <span class="badge badge-success">Valid</span>
                        {% else %}
                            <span class="badge badge-danger">{{ row.reason }}</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% else %}
<div class="card" style="max-width: 720px;">
    <h3 style="font-size: 1.05rem; font-weight: 600; margin-bottom: 12px;">Upload CSV File</h3>
    <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 16px;">
        Upload an employee roster CSV file. The columns can match your organization's employee export format directly.
    </p>

    <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: 8px; padding: 16px; margin-bottom: 20px;">
        <div style="font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 8px;">Supported CSV Header Format:</div>
        <code style="font-size: 0.85rem; color: #0284c7; display: block; background: #fff; padding: 8px 12px; border-radius: 4px; border: 1px solid #e2e8f0; margin-bottom: 10px;">
            SL NO, ZONE/Region, EMP CODE, EMP NAME, DEPARTMENT, DESIGNATION
        </code>
        <ul style="font-size: 0.825rem; color: #64748b; margin-left: 18px; line-height: 1.6;">
            <li><strong>EMP CODE</strong> and <strong>EMP NAME</strong> are required. Leading zeros in employee codes (e.g. <code>000169</code>) are preserved.</li>
            <li><strong>ZONE/Region</strong>, <strong>DEPARTMENT</strong>, and <strong>DESIGNATION</strong> will be saved to each employee's profile.</li>
            <li>Existing employee codes will have their name, zone/region, department, and designation updated.</li>
            <li>Maximum file size: 5 MB (up to 20,000 rows).</li>
        </ul>
    </div>

    <form action="/admin/employees/import/preview" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label class="form-label" for="csv_file">Select CSV File</label>
            <input type="file" id="csv_file" name="csv_file" accept=".csv" required class="form-control">
        </div>
        <div style="display: flex; gap: 12px; align-items: center; margin-top: 20px;">
            <button type="submit" class="btn btn-primary">
                Upload & Preview
            </button>
            <a href="/admin/employees/sample-csv" class="btn btn-secondary">
                Download Sample CSV
            </a>
        </div>
    </form>
</div>
{% endif %}
{% endblock %}
