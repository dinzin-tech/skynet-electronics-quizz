{% extends "admin/layout.html.twig" %}

{% block page_title %}Question Banks{% endblock %}

{% block content %}
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div>
        <h2 style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin: 0;">Question Banks</h2>
        <p style="color: #64748b; font-size: 0.875rem; margin: 4px 0 0 0;">Create and maintain central repositories of questions for assessments.</p>
    </div>
    <div style="display: flex; gap: 10px;">
        <form action="/admin/question-banks/sync-legacy" method="POST" style="margin: 0;">
            <button type="submit" class="btn btn-secondary" title="Scan and package any direct quiz questions into Question Banks">
                ⚡ Sync Legacy Questions
            </button>
        </form>
        <a href="/admin/question-banks/sample-template" class="btn btn-secondary">
            📥 Sample Template (.csv)
        </a>
        <a href="/admin/question-banks/create" class="btn btn-primary">
            + Create Question Bank
        </a>
    </div>
</div>

{% if success %}
    <div class="alert alert-success">{{ success|raw }}</div>
{% endif %}

{% if error %}
    <div class="alert alert-error">{{ error|raw }}</div>
{% endif %}

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-title">Total Question Banks</div>
        <div class="kpi-val">{{ banks|length }}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-title">Total Questions</div>
        <div class="kpi-val">
            {% set totalQ = 0 %}
            {% for b in banks %}
                {% set totalQ = totalQ + b.question_count %}
            {% endfor %}
            {{ totalQ }}
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-title">Active / In-Use Banks</div>
        <div class="kpi-val" style="color: #0284c7;">
            {% set lockedCount = 0 %}
            {% for b in banks %}
                {% if b.is_locked %}
                    {% set lockedCount = lockedCount + 1 %}
                {% endif %}
            {% endfor %}
            {{ lockedCount }}
        </div>
    </div>
</div>

<div class="card" style="padding: 0; overflow: hidden;">
    <div class="table-wrap" style="border: none;">
        <table>
            <thead>
                <tr>
                    <th style="width: 30%;">Bank Title</th>
                    <th style="width: 15%;">Questions</th>
                    <th style="width: 18%;">Linked Quizzes</th>
                    <th style="width: 14%;">Editing Status</th>
                    <th style="width: 13%;">Created At</th>
                    <th style="width: 10%; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for b in banks %}
                <tr>
                    <td>
                        <div style="font-weight: 600; color: #1e293b; font-size: 0.95rem;">
                            <a href="/admin/question-banks/{{ b.id }}/questions" style="color: #1e293b; text-decoration: none;">
                                {{ b.title }}
                            </a>
                        </div>
                        {% if b.description %}
                            <div style="font-size: 0.8125rem; color: #64748b; margin-top: 3px; max-width: 380px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                {{ b.description }}
                            </div>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge {% if b.question_count > 0 %}badge-info{% else %}badge-warning{% endif %}" style="font-size: 0.8rem; padding: 4px 10px;">
                            📝 {{ b.question_count }} {{ b.question_count == 1 ? 'question' : 'questions' }}
                        </span>
                    </td>
                    <td>
                        {% if b.linked_quizzes_count > 0 %}
                            <span class="badge badge-success" style="font-size: 0.8rem; padding: 4px 10px;">
                                🎯 {{ b.linked_quizzes_count }} {{ b.linked_quizzes_count == 1 ? 'quiz' : 'quizzes' }}
                            </span>
                        {% else %}
                            <span style="font-size: 0.85rem; color: #94a3b8;">None</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if b.is_locked %}
                            <span class="badge badge-danger" title="A linked quiz is currently published and open for attempts. Modifications to questions are locked." style="font-size: 0.775rem;">
                                🔒 Quiz In-Progress
                            </span>
                        {% else %}
                            <span class="badge badge-success" style="font-size: 0.775rem;">
                                ✏️ Modifiable
                            </span>
                        {% endif %}
                    </td>
                    <td style="font-size: 0.85rem; color: #64748b;">
                        {{ b.created_at|company_date }}
                    </td>
                    <td style="text-align: right;">
                        <div style="display: flex; gap: 6px; justify-content: flex-end; align-items: center;">
                            <a href="/admin/question-banks/{{ b.id }}/questions" class="btn btn-primary" style="padding: 4px 10px; font-size: 0.8rem;">
                                Manage Questions
                            </a>
                            <a href="/admin/question-banks/{{ b.id }}/edit" class="btn btn-secondary" style="padding: 4px 8px; font-size: 0.8rem;">
                                Edit
                            </a>
                            {% if not b.is_locked %}
                                <form action="/admin/question-banks/{{ b.id }}/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this question bank? All contained questions will be permanently deleted.');">
                                    <button type="submit" class="btn" style="background: #fee2e2; color: #dc2626; border: none; padding: 4px 8px; font-size: 0.8rem; border-radius: 6px; cursor: pointer;">
                                        Delete
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" style="text-align: center; color: #64748b; padding: 40px;">
                        No question banks found. Click <strong>+ Create Question Bank</strong> above to start.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
