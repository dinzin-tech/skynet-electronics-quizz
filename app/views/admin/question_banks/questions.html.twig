{% extends "admin/layout.html.twig" %}

{% block page_title %}Questions - {{ bank.title }}{% endblock %}

{% block content %}
<div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
    <a href="/admin/question-banks" style="font-size: 0.875rem; color: #2563eb; text-decoration: none;">&larr; Back to Question Banks</a>
    <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
        {% if not bank.is_locked %}
            <a href="#bulk-import-card" class="btn btn-secondary" style="padding: 6px 14px; font-size: 0.85rem; background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                📥 Bulk Question Upload
            </a>
            <a href="#manual-add-card" class="btn btn-primary" style="padding: 6px 14px; font-size: 0.85rem;">
                + Add Question
            </a>
        {% endif %}
    </div>
</div>

{% if success %}
    <div class="alert alert-success">{{ success|raw }}</div>
{% endif %}
{% if error %}
    <div class="alert alert-error">{{ error|raw }}</div>
{% endif %}

{% if bank.is_locked %}
    <div class="alert alert-warning" style="display: flex; align-items: center; gap: 10px; margin-bottom: 24px; border-left: 4px solid #f59e0b; background: #fffbeb; color: #92400e;">
        <span style="font-size: 1.25rem;">🔒</span>
        <div>
            <strong>Question Editing Locked:</strong> This question bank is currently linked to one or more active or published quizzes with participants. 
            Modifications to questions and options are disabled to ensure fair grading and snapshot consistency.
        </div>
    </div>
{% endif %}

<!-- Bank Header Card -->
<div class="card" style="margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                <h2 style="font-size: 1.35rem; font-weight: 700; margin: 0; color: #1e293b;">{{ bank.title }}</h2>
                {% if bank.is_locked %}
                    <span class="badge badge-danger">🔒 In-Use (Locked)</span>
                {% else %}
                    <span class="badge badge-success">✏️ Editable</span>
                {% endif %}
            </div>
            {% if bank.description %}
                <p style="font-size: 0.875rem; color: #64748b; margin: 0 0 8px 0;">{{ bank.description }}</p>
            {% endif %}
            <p style="font-size: 0.85rem; color: #475569; margin: 0;">
                Total Questions in Bank: <strong id="total-questions-count">{{ questions|length }}</strong> &bull;
                Linked Quizzes: <strong>{{ bank.linked_quizzes_count|default(0) }}</strong>
            </p>
        </div>
        <div style="display: flex; gap: 8px;">
            <a href="/admin/question-banks/{{ bank.id }}/edit" class="btn btn-secondary" style="font-size: 0.825rem; padding: 6px 12px;">
                Edit Bank Details
            </a>
        </div>
    </div>
</div>

{% if not bank.is_locked %}
<!-- Bulk Question Upload Card -->
<div id="bulk-import-card" class="card" style="margin-bottom: 26px; border-left: 4px solid #16a34a; background: #fafdfa;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-bottom: 14px;">
        <div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: #166534;">
                    📥 Bulk Question Upload (Excel / CSV)
                </h3>
                <span class="badge" style="background: #dcfce7; color: #15803d; font-size: 0.75rem; font-weight: 700;">Supports 40+ Questions</span>
            </div>
            <p style="font-size: 0.85rem; color: #475569; margin: 4px 0 0 0;">
                Quickly populate your question bank in one upload. Supports both <strong>Multiple Choice Questions (MCQ)</strong> and <strong>Written-Answer Questions</strong>.
            </p>
        </div>
        <a href="/admin/question-banks/sample-template" class="btn btn-secondary" style="font-size: 0.85rem; padding: 7px 14px; background: #ffffff; color: #166534; border: 1px solid #86efac; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
            <span>📄</span> Download Excel/CSV Sample Template
        </a>
    </div>

    <form action="/admin/question-banks/{{ bank.id }}/questions/import" method="POST" enctype="multipart/form-data" style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap; background: #ffffff; padding: 16px; border-radius: 8px; border: 1px solid #dcfce7;">
        <div style="flex: 1; min-width: 260px;">
            <label style="display: block; font-size: 0.8rem; font-weight: 600; color: #334155; margin-bottom: 4px;">
                Select Excel (.xlsx) or CSV (.csv) file with questions:
            </label>
            <input type="file" name="questions_file" accept=".csv,.xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv" required class="form-control" style="font-size: 0.85rem; padding: 6px 12px;">
        </div>
        <div style="padding-top: 18px;">
            <button type="submit" class="btn btn-primary" style="background: #16a34a; border-color: #15803d; font-weight: 600; padding: 8px 20px; font-size: 0.9rem;">
                Upload & Import to Bank
            </button>
        </div>
    </form>

    <div style="margin-top: 12px; font-size: 0.8rem; color: #64748b; line-height: 1.45;">
        <strong>Excel Format Guidelines:</strong> Required columns: <code>Question Text</code>, <code>Question Type</code> (<code>mcq</code> or <code>written</code>), <code>Option A</code>, <code>Option B</code>, <code>Option C</code>, <code>Option D</code>, <code>Correct Option</code> (<code>A</code>, <code>B</code>, <code>C</code>, or <code>D</code> for MCQs; leave blank for written questions).
    </div>
</div>

<!-- Add Questions Form -->
<div id="manual-add-card" class="card" style="margin-bottom: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
        <h3 style="font-size: 1.15rem; font-weight: 600; margin: 0;">
            Add Questions Manually
        </h3>
        <span style="font-size: 0.825rem; color: #64748b;">Fill in questions below, choose question type (MCQ or Written), and save.</span>
    </div>

    <form id="multi-question-form" action="/admin/question-banks/{{ bank.id }}/questions" method="POST" enctype="multipart/form-data">
        <div id="questions-container" style="display: flex; flex-direction: column; gap: 24px;">
            <!-- Question 0 Initial Block -->
            <div class="question-block" data-index="0" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                    <span class="question-num-badge" style="font-weight: 700; font-size: 0.95rem; color: #2563eb;">New Question #1</span>
                    <button type="button" class="btn-remove-q btn" style="display: none; background: #fee2e2; color: #dc2626; border: none; padding: 3px 10px; font-size: 0.775rem; border-radius: 4px; cursor: pointer;" onclick="removeQuestionBlock(this)">✕ Remove</button>
                </div>

                <div style="display: flex; gap: 16px; margin-bottom: 16px; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 220px;">
                        <label class="form-label" style="font-weight: 500;">Question Type *</label>
                        <select name="questions[0][type]" class="form-control q-type-select" style="max-width: 320px;" onchange="handleTypeChange(this, 0)">
                            <option value="mcq">Multiple Choice Question (MCQ)</option>
                            <option value="written">Written-Answer Question (Text Response)</option>
                        </select>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                    <label class="form-label" style="font-weight: 500;">Question Prompt *</label>
                    <textarea name="questions[0][text]" rows="2" required class="form-control" placeholder="Type the question prompt here..."></textarea>
                </div>

                <!-- Optional Question Image -->
                <div class="form-group" style="margin-bottom: 18px;">
                    <label class="form-label" style="font-weight: 500; display: flex; align-items: center; gap: 6px;">
                        <span>Question Image</span>
                        <small style="color: #64748b; font-weight: normal;">(Optional - PNG, JPG, WEBP, GIF)</small>
                    </label>
                    <div style="display: flex; align-items: center; gap: 16px;">
                        <input type="file" name="question_image_0" accept="image/*" class="form-control" style="max-width: 380px; padding: 6px 12px; font-size: 0.85rem;" onchange="handleImagePreview(this, 0)">
                        <div id="img-preview-0" style="display: none; align-items: center; gap: 8px;">
                            <img src="" alt="Preview" style="max-height: 48px; border-radius: 4px; border: 1px solid #cbd5e1; object-fit: contain;">
                            <button type="button" style="background: transparent; border: none; color: #ef4444; font-size: 0.775rem; cursor: pointer;" onclick="clearImagePreview(0)">Remove</button>
                        </div>
                    </div>
                </div>

                <!-- Options (MCQ only) -->
                <div id="options-wrapper-0" class="q-options-wrapper">
                    <label class="form-label" style="margin-bottom: 10px; font-weight: 500;">
                        Answer Options <small style="color: #64748b; font-weight: normal;">(select the radio button next to the correct answer) *</small>
                    </label>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        {% for optIdx in 0..3 %}
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="display: flex; align-items: center; gap: 8px; min-width: 140px;">
                                <input type="radio" id="q_0_opt_{{ optIdx }}" name="questions[0][correct_option]" value="{{ optIdx }}" {% if optIdx == 0 %}checked{% endif %}>
                                <label for="q_0_opt_{{ optIdx }}" style="font-size: 0.85rem; cursor: pointer; color: #475569; font-weight: 500;">
                                    {% if optIdx == 0 %}Option A{% elseif optIdx == 1 %}Option B{% elseif optIdx == 2 %}Option C{% else %}Option D{% endif %}
                                    <span style="font-size: 0.75rem; color: #16a34a;">(Correct)</span>
                                </label>
                            </div>
                            <input type="text" name="questions[0][options][]" class="form-control q-opt-input" placeholder="Option {{ loop.index }} text..." {% if optIdx < 2 %}required{% endif %} style="flex: 1;">
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-color); flex-wrap: wrap; gap: 12px;">
            <button type="button" class="btn btn-secondary" onclick="addAnotherQuestionBlock()" style="background: #f1f5f9; border-color: #cbd5e1; font-weight: 600;">
                + Add Another Question Row
            </button>
            <button type="submit" class="btn btn-primary" style="padding: 10px 28px; font-weight: 600; font-size: 0.95rem;">
                Save Question(s) to Bank
            </button>
        </div>
    </form>
</div>
{% endif %}

<!-- Questions List Section -->
<div class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 18px 24px; border-bottom: 1px solid var(--border-color); background: #f8fafc; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: #1e293b;">
            Questions in this Bank ({{ questions|length }})
        </h3>
        <span style="font-size: 0.8rem; color: #64748b;">
            Questions can be re-ordered using drag or up/down arrows.
        </span>
    </div>

    {% if questions|length == 0 %}
        <div style="padding: 48px; text-align: center; color: #64748b;">
            <div style="font-size: 2rem; margin-bottom: 8px;">📭</div>
            <strong>No questions in this bank yet.</strong>
            <p style="margin: 6px 0 0 0; font-size: 0.875rem;">Use the forms above to add questions manually or import an Excel/CSV file.</p>
        </div>
    {% else %}
        <div style="display: flex; flex-direction: column;">
            {% for q in questions %}
            <div class="question-list-row" style="padding: 20px 24px; border-bottom: 1px solid #e2e8f0; display: flex; gap: 16px; align-items: flex-start; background: #ffffff;">
                <div style="width: 32px; height: 32px; background: #e0f2fe; color: #0284c7; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; flex-shrink: 0;">
                    {{ q.display_order }}
                </div>

                <div style="flex: 1; min-width: 0;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                        {% if q.type == 'written' %}
                            <span class="badge" style="background: #fef3c7; color: #92400e; font-size: 0.725rem;">Written Answer</span>
                        {% else %}
                            <span class="badge badge-info" style="font-size: 0.725rem;">MCQ</span>
                        {% endif %}
                        <span style="font-weight: 600; color: #1e293b; font-size: 0.975rem;">{{ q.question_text }}</span>
                    </div>

                    {% if q.image_path %}
                        <div style="margin: 8px 0;">
                            <img src="{{ q.image_path }}" alt="Question illustration" style="max-height: 90px; border-radius: 6px; border: 1px solid #e2e8f0; object-fit: contain;">
                        </div>
                    {% endif %}

                    {% if q.type != 'written' and q.options is not empty %}
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px; margin-top: 10px;">
                            {% for opt in q.options %}
                                <div style="padding: 6px 10px; border-radius: 6px; font-size: 0.85rem; display: flex; align-items: center; gap: 6px; {% if opt.is_correct %}background: #dcfce7; border: 1px solid #86efac; color: #15803d; font-weight: 600;{% else %}background: #f8fafc; border: 1px solid #e2e8f0; color: #475569;{% endif %}">
                                    <span>{% if opt.is_correct %}✓{% else %}○{% endif %}</span>
                                    <span>{{ opt.option_text }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                {% if not bank.is_locked %}
                <div style="display: flex; gap: 6px; align-items: center; flex-shrink: 0;">
                    <button type="button" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.8rem;" onclick='openEditModal({{ q|json_encode|e('js') }})'>
                        Edit
                    </button>
                    <form action="/admin/question-banks/{{ bank.id }}/questions/{{ q.id }}/delete" method="POST" onsubmit="return confirm('Delete this question permanently?');" style="margin: 0;">
                        <button type="submit" class="btn" style="background: #fee2e2; color: #dc2626; border: none; padding: 4px 10px; font-size: 0.8rem; border-radius: 6px; cursor: pointer;">
                            Delete
                        </button>
                    </form>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

<!-- Edit Question Modal -->
<div id="edit-q-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(3px);">
    <div style="background: #ffffff; width: 90%; max-width: 650px; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); overflow: hidden; max-height: 90vh; display: flex; flex-direction: column;">
        <div style="padding: 16px 20px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: #1e293b;">Edit Question</h3>
            <button type="button" onclick="closeEditModal()" style="background: none; border: none; font-size: 1.25rem; cursor: pointer; color: #64748b;">&times;</button>
        </div>

        <form id="edit-q-form" action="" method="POST" enctype="multipart/form-data" style="padding: 20px; overflow-y: auto;">
            <div class="form-group">
                <label class="form-label">Question Type</label>
                <select id="modal-q-type" name="question_type" class="form-control" onchange="toggleModalType(this.value)">
                    <option value="mcq">Multiple Choice Question (MCQ)</option>
                    <option value="written">Written-Answer Question</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Question Prompt *</label>
                <textarea id="modal-q-text" name="question_text" rows="3" required class="form-control"></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Question Image</label>
                <div id="modal-existing-img" style="margin-bottom: 8px; display: none;">
                    <img id="modal-img-tag" src="" alt="Existing Image" style="max-height: 60px; border-radius: 4px; border: 1px solid #cbd5e1;">
                    <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; color: #dc2626; margin-left: 10px; cursor: pointer;">
                        <input type="checkbox" name="remove_image" value="1"> Remove current image
                    </label>
                </div>
                <input type="file" name="question_image" accept="image/*" class="form-control" style="font-size: 0.85rem; padding: 6px 12px;">
            </div>

            <div id="modal-options-section">
                <label class="form-label" style="font-weight: 600; margin-bottom: 8px;">MCQ Answer Options *</label>
                <div id="modal-options-list" style="display: flex; flex-direction: column; gap: 8px;">
                    <!-- Dynamically populated via JS -->
                </div>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; padding-top: 14px; border-top: 1px solid #e2e8f0;">
                <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Cancel</button>
                <button type="submit" class="btn btn-primary" style="padding: 8px 24px;">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
var qCounter = 1;

function handleTypeChange(selectElem, idx) {
    var wrapper = document.getElementById('options-wrapper-' + idx);
    if (!wrapper) return;
    if (selectElem.value === 'written') {
        wrapper.style.display = 'none';
        wrapper.querySelectorAll('input.q-opt-input').forEach(function(i) { i.removeAttribute('required'); });
    } else {
        wrapper.style.display = 'block';
        var inputs = wrapper.querySelectorAll('input.q-opt-input');
        if (inputs.length >= 2) {
            inputs[0].setAttribute('required', 'required');
            inputs[1].setAttribute('required', 'required');
        }
    }
}

function handleImagePreview(fileInput, idx) {
    var prev = document.getElementById('img-preview-' + idx);
    if (!prev) return;
    if (fileInput.files && fileInput.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
            var img = prev.querySelector('img');
            if (img) img.src = e.target.result;
            prev.style.display = 'flex';
        };
        reader.readAsDataURL(fileInput.files[0]);
    }
}

function clearImagePreview(idx) {
    var prev = document.getElementById('img-preview-' + idx);
    var input = document.querySelector('input[name="question_image_' + idx + '"]');
    if (input) input.value = '';
    if (prev) {
        var img = prev.querySelector('img');
        if (img) img.src = '';
        prev.style.display = 'none';
    }
}

function addAnotherQuestionBlock() {
    var container = document.getElementById('questions-container');
    var idx = qCounter++;
    var block = document.createElement('div');
    block.className = 'question-block';
    block.dataset.index = idx;
    block.style.background = '#f8fafc';
    block.style.border = '1px solid #e2e8f0';
    block.style.borderRadius = '8px';
    block.style.padding = '20px';

    block.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <span class="question-num-badge" style="font-weight: 700; font-size: 0.95rem; color: #2563eb;">New Question #${idx + 1}</span>
            <button type="button" class="btn-remove-q btn" style="background: #fee2e2; color: #dc2626; border: none; padding: 3px 10px; font-size: 0.775rem; border-radius: 4px; cursor: pointer;" onclick="removeQuestionBlock(this)">✕ Remove</button>
        </div>

        <div style="display: flex; gap: 16px; margin-bottom: 16px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 220px;">
                <label class="form-label" style="font-weight: 500;">Question Type *</label>
                <select name="questions[${idx}][type]" class="form-control q-type-select" style="max-width: 320px;" onchange="handleTypeChange(this, ${idx})">
                    <option value="mcq">Multiple Choice Question (MCQ)</option>
                    <option value="written">Written-Answer Question (Text Response)</option>
                </select>
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label" style="font-weight: 500;">Question Prompt *</label>
            <textarea name="questions[${idx}][text]" rows="2" required class="form-control" placeholder="Type the question prompt here..."></textarea>
        </div>

        <div class="form-group" style="margin-bottom: 18px;">
            <label class="form-label" style="font-weight: 500; display: flex; align-items: center; gap: 6px;">
                <span>Question Image</span>
                <small style="color: #64748b; font-weight: normal;">(Optional - PNG, JPG, WEBP, GIF)</small>
            </label>
            <div style="display: flex; align-items: center; gap: 16px;">
                <input type="file" name="question_image_${idx}" accept="image/*" class="form-control" style="max-width: 380px; padding: 6px 12px; font-size: 0.85rem;" onchange="handleImagePreview(this, ${idx})">
                <div id="img-preview-${idx}" style="display: none; align-items: center; gap: 8px;">
                    <img src="" alt="Preview" style="max-height: 48px; border-radius: 4px; border: 1px solid #cbd5e1; object-fit: contain;">
                    <button type="button" style="background: transparent; border: none; color: #ef4444; font-size: 0.775rem; cursor: pointer;" onclick="clearImagePreview(${idx})">Remove</button>
                </div>
            </div>
        </div>

        <div id="options-wrapper-${idx}" class="q-options-wrapper">
            <label class="form-label" style="margin-bottom: 10px; font-weight: 500;">
                Answer Options <small style="color: #64748b; font-weight: normal;">(select radio next to correct answer) *</small>
            </label>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 8px; min-width: 140px;">
                        <input type="radio" id="q_${idx}_opt_0" name="questions[${idx}][correct_option]" value="0" checked>
                        <label for="q_${idx}_opt_0" style="font-size: 0.85rem; cursor: pointer; color: #475569; font-weight: 500;">Option A <span style="font-size: 0.75rem; color: #16a34a;">(Correct)</span></label>
                    </div>
                    <input type="text" name="questions[${idx}][options][]" class="form-control q-opt-input" placeholder="Option 1 text..." required style="flex: 1;">
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 8px; min-width: 140px;">
                        <input type="radio" id="q_${idx}_opt_1" name="questions[${idx}][correct_option]" value="1">
                        <label for="q_${idx}_opt_1" style="font-size: 0.85rem; cursor: pointer; color: #475569; font-weight: 500;">Option B</label>
                    </div>
                    <input type="text" name="questions[${idx}][options][]" class="form-control q-opt-input" placeholder="Option 2 text..." required style="flex: 1;">
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 8px; min-width: 140px;">
                        <input type="radio" id="q_${idx}_opt_2" name="questions[${idx}][correct_option]" value="2">
                        <label for="q_${idx}_opt_2" style="font-size: 0.85rem; cursor: pointer; color: #475569; font-weight: 500;">Option C</label>
                    </div>
                    <input type="text" name="questions[${idx}][options][]" class="form-control q-opt-input" placeholder="Option 3 text..." style="flex: 1;">
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 8px; min-width: 140px;">
                        <input type="radio" id="q_${idx}_opt_3" name="questions[${idx}][correct_option]" value="3">
                        <label for="q_${idx}_opt_3" style="font-size: 0.85rem; cursor: pointer; color: #475569; font-weight: 500;">Option D</label>
                    </div>
                    <input type="text" name="questions[${idx}][options][]" class="form-control q-opt-input" placeholder="Option 4 text..." style="flex: 1;">
                </div>
            </div>
        </div>
    `;

    container.appendChild(block);
}

function removeQuestionBlock(btn) {
    var block = btn.closest('.question-block');
    if (block) block.remove();
}

function openEditModal(q) {
    var modal = document.getElementById('edit-q-modal');
    var form = document.getElementById('edit-q-form');
    form.action = '/admin/question-banks/{{ bank.id }}/questions/' + q.id + '/edit';

    document.getElementById('modal-q-type').value = q.type || 'mcq';
    document.getElementById('modal-q-text').value = q.question_text || '';

    // Handle image
    var imgWrapper = document.getElementById('modal-existing-img');
    var imgTag = document.getElementById('modal-img-tag');
    if (q.image_path) {
        imgTag.src = q.image_path;
        imgWrapper.style.display = 'block';
    } else {
        imgWrapper.style.display = 'none';
    }

    // Populate options
    var optList = document.getElementById('modal-options-list');
    optList.innerHTML = '';
    var options = q.options || [];

    for (var i = 0; i < 4; i++) {
        var opt = options[i] || {};
        var optText = opt.option_text || '';
        var isCorr = parseInt(opt.is_correct || 0, 10) === 1;

        var row = document.createElement('div');
        row.style.display = 'flex';
        row.style.alignItems = 'center';
        row.style.gap = '10px';
        row.innerHTML = `
            <div style="display: flex; align-items: center; gap: 6px; min-width: 110px;">
                <input type="radio" id="modal_opt_${i}" name="correct_option" value="${i}" ${isCorr ? 'checked' : ''}>
                <label for="modal_opt_${i}" style="font-size: 0.825rem; font-weight: 500; cursor: pointer;">Option ${String.fromCharCode(65 + i)}</label>
            </div>
            <input type="text" name="options[]" class="form-control" value="${optText.replace(/"/g, '&quot;')}" placeholder="Option ${i + 1} text..." style="flex: 1; font-size: 0.85rem;">
        `;
        optList.appendChild(row);
    }

    toggleModalType(q.type || 'mcq');
    modal.style.display = 'flex';
}

function toggleModalType(type) {
    var optSec = document.getElementById('modal-options-section');
    if (type === 'written') {
        optSec.style.display = 'none';
    } else {
        optSec.style.display = 'block';
    }
}

function closeEditModal() {
    document.getElementById('edit-q-modal').style.display = 'none';
}
</script>
{% endblock %}
